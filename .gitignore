# ===========================================================================
# Google Android Platform-Tools & Binary Exclusions
# ===========================================================================
# Do not commit proprietary or platform-dependent binaries to the repository.
# Users should download platform-tools from Google's official CDN.
*.exe
*.dll
*.so
*.dylib
platform-tools/
platform-tools-*/
platform-tools.zip
platform-tools-*.zip
AdbWinApi.dll
AdbWinUsbApi.dll
libwinpthread-1.dll
adb
fastboot
mke2fs
make_f2fs
make_f2fs_casefold
etc1tool
hprof-conv
sqlite3
mke2fs.conf
source.properties
NOTICE.txt

